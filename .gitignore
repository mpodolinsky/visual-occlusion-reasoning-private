.venv/
.libero/

__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Generated simulator captures and other experiment artifacts.
outputs/*
!outputs/.gitkeep

# Local wandb run logs (synced to wandb.ai, not needed in git).
wandb/

# Local/editor files.
.DS_Store
.idea/
.vscode/
.claude/

submodules/*

# Reference papers / PDFs (not source).
*.pdf

# Perception probe experiment artifacts: generated plots and probe weight dumps.
# Regenerated locally from the calibration/sweep scripts; not needed in git.
scripts/perception_probe/**/*.png
scripts/perception_probe/**/*.npz

# Archived exploratory notebooks with large embedded output.
scripts/perception_probe/calibration/archive/

# Per-run calibration/sweep outputs (result JSON, summaries, model_run_dir).
scripts/perception_probe/calibration/**/runs/
